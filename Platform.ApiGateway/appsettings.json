{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": -1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "platform",
          "Version": "v1"
        }
      },
      "orders-orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        }
      },
      "orders-customers": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/customers/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        }
      },
      "orders-products": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/products/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "orders",
          "Version": "v1"
        }
      },
      "catalog-perfumes": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/perfumes/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "catalog-brands": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/brands/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "catalog-notes": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/notes/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "reviews",
          "Version": "v1"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "orders": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://orders-api" } }
      },
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://catalog-api" } }
      },
      "reviews": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  }
}